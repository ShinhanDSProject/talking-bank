# 이 파일을 복사해 같은 자리에 .env 로 두면 로컬에서 API 서버(apps/api)와 웹(apps/web)이 함께 읽는다. .env 는 Git 제외.
#   cp .env.example .env
# 로컬은 .env 가 없어도 뜬다. 운영은 이 파일이 아니라 서버 환경 변수로 넣는다(application-prod.yaml 참고).
# 브라우저 번들에는 VITE_ 로 시작하는 값만 들어간다. 나머지는 서버 전용.

# ── api ──────────────────────────────────────────────
# JWT 서명 키(32자 이상). 비워 두면 로컬은 기동 때 임시 키를 만든다(재시작하면 토큰 무효).
JWT_SECRET=
# 연속 로그인 실패 허용 횟수 (기본 5). 개발 중 잠금이 번거로우면 999.
MAX_LOGIN_FAIL=5

# ── web ──────────────────────────────────────────────
# 배포 시 API 서버 주소. 비워 두면 같은 출처의 /api 로 요청한다.
VITE_API_BASE_URL=
# 개발 중 Vite dev 서버가 /api 요청을 넘길 대상 (기본값 http://localhost:8080)
VITE_API_PROXY_TARGET=http://localhost:8080
