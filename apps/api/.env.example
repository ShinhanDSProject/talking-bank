# 이 파일을 복사해 같은 폴더에 .env 로 두면 API 서버가 읽는다 (Git 제외).
#   cp apps/api/.env.example apps/api/.env
# 로컬(local 프로필)은 .env 가 없어도 개발용 기본값으로 뜬다. 운영(prod 프로필)은 JWT_SECRET 이 없으면 기동되지 않는다.
# 환경별로 달라지는 설정(쿠키 Secure · ddl-auto · 로그 레벨)은 여기가 아니라 application-<profile>.yaml 에 있다.

# JWT 서명 키. 32자 이상. 운영에서는 반드시 새로 만든다.
JWT_SECRET=

# 연속 로그인 실패 허용 횟수 (기본 5). 개발 중 잠금이 번거로우면 999.
MAX_LOGIN_FAIL=5
